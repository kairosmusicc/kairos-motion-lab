{
  "name": "kairos-motion-lab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render": "node --import tsx scripts/render-v2.ts",
    "stills": "node --import tsx scripts/render-v2.ts --stills-only",
    "check": "node --import tsx scripts/check-v2.ts",
    "draft": "node --import tsx scripts/render-v2.ts --draft",
    "render:v1": "node --import tsx scripts/render-variants.ts --variant v1",
    "analyze": ".venv/bin/python scripts/analyze-audio.py",
    "check:v2": "node --import tsx scripts/check-v2.ts",
    "check:v1": "node --import tsx scripts/check-output.ts",
    "prepare:v3": "python scripts/prepare-v3-sources.py",
    "render:v3": "node --import tsx scripts/render-v3.ts",
    "draft:v3": "node --import tsx scripts/render-v3.ts --draft",
    "stills:v3": "node --import tsx scripts/render-v3.ts --stills-only",
    "check:v3": "node --import tsx scripts/check-v3.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@remotion/bundler": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/media": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.541",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
